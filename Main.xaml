    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Main Sequence" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="studentName" />
      <Variable x:TypeArguments="x:String" Name="usn" />
      <Variable x:TypeArguments="x:String" Name="email" />
      <Variable x:TypeArguments="x:String" Name="phone" />
      <Variable x:TypeArguments="x:String" Name="course" />
      <Variable x:TypeArguments="x:Boolean" Name="validDetails" />
      <Variable x:TypeArguments="x:String" Name="outputPath" />
      <Variable x:TypeArguments="x:String" Name="csvContent" />
    </Sequence.Variables>
    <Sequence DisplayName="Collect and Validate Student Details">
      <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}" DisplayName="Enter Student Name" IsPassword="False" Label="Enter student name:" Title="Student Registration" TopMost="False">
        <ui:InputDialog.Result>
          <OutArgument x:TypeArguments="x:String">[studentName]</OutArgument>
        </ui:InputDialog.Result>
      </ui:InputDialog>
      <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}" DisplayName="Enter USN" IsPassword="False" Label="Enter USN:" Title="Student Registration" TopMost="False">
        <ui:InputDialog.Result>
          <OutArgument x:TypeArguments="x:String">[usn]</OutArgument>
        </ui:InputDialog.Result>
      </ui:InputDialog>
      <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}" DisplayName="Enter Email" IsPassword="False" Label="Enter email address:" Title="Student Registration" TopMost="False">
        <ui:InputDialog.Result>
          <OutArgument x:TypeArguments="x:String">[email]</OutArgument>
        </ui:InputDialog.Result>
      </ui:InputDialog>
      <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}" DisplayName="Enter Phone Number" IsPassword="False" Label="Enter 10-digit phone number:" Title="Student Registration" TopMost="False">
        <ui:InputDialog.Result>
          <OutArgument x:TypeArguments="x:String">[phone]</OutArgument>
        </ui:InputDialog.Result>
      </ui:InputDialog>
      <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}" DisplayName="Enter Course" IsPassword="False" Label="Enter course:" Title="Student Registration" TopMost="False">
        <ui:InputDialog.Result>
          <OutArgument x:TypeArguments="x:String">[course]</OutArgument>
        </ui:InputDialog.Result>
      </ui:InputDialog>
      <Assign x:TypeArguments="x:Boolean" DisplayName="Validate Student Details" To="[validDetails]" Value="[Not String.IsNullOrWhiteSpace(studentName) AndAlso System.Text.RegularExpressions.Regex.IsMatch(studentName.Trim, &quot;^[A-Za-z][A-Za-z .'-]{1,49}$&quot;) AndAlso Not String.IsNullOrWhiteSpace(usn) AndAlso System.Text.RegularExpressions.Regex.IsMatch(usn.Trim, &quot;^[A-Za-z0-9]{4,20}$&quot;) AndAlso Not String.IsNullOrWhiteSpace(email) AndAlso System.Text.RegularExpressions.Regex.IsMatch(email.Trim, &quot;^[^@\s]+@[^@\s]+\.[^@\s]+$&quot;) AndAlso System.Text.RegularExpressions.Regex.IsMatch(phone.Trim, &quot;^[0-9]{10}$&quot;) AndAlso Not String.IsNullOrWhiteSpace(course)]" />
      <If Condition="[Not validDetails]" DisplayName="Show Validation Message">
        <If.Then>
          <Sequence DisplayName="Invalid Details">
            <ui:MessageBox DisplayName="Invalid Student Details" Caption="Validation Error" Text="Invalid details. Please check the name, USN, email address, 10-digit phone number, and course." />
          </Sequence>
        </If.Then>
      </If>
    </Sequence>
    <Assign x:TypeArguments="x:String" DisplayName="Set Registration File Path" To="[outputPath]" Value="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;StudentRegistration.csv&quot;)]" />
    <Assign x:TypeArguments="x:String" DisplayName="Build Excel-Compatible CSV Content" To="[csvContent]" Value="[&quot;Name,USN,Email,Phone,Course&quot; &amp; Environment.NewLine &amp; String.Join(&quot;,&quot;, New String() {studentName.Trim, usn.Trim, email.Trim, phone.Trim, course.Trim})]" />
    <ui:WriteTextFile DisplayName="Save Student Registration" FileName="[outputPath]" Text="[csvContent]" />
    <ui:MessageBox DisplayName="Registration Successful" Caption="Student Registration" Text="[&quot;Registration successful! Student information was saved to: &quot; &amp; outputPath]" />
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
  </Sequence>
</Activity>
